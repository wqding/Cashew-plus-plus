{
  "id": "scotiabank_pdf_v1",
  "version": 1,
  "display_name": "Scotiabank credit card PDF",
  "source_kind": "pdf",
  "match": {
    "keywords_all": ["Statement Period", "REF.#"],
    "keywords_any": ["Scotia", "Momentum"],
    "filetypes": ["pdf"]
  },
  "period": {
    "regex": "(\\w{3}\\s+\\d{1,2},?\\s+\\d{4})\\s*[-–]\\s*(\\w{3}\\s+\\d{1,2},?\\s+\\d{4})",
    "year_strategy": "from_period_end"
  },
  "section": {
    "start_regex": "Transactions since your last statement",
    "end_regex": "SUB-TOTAL"
  },
  "row": {
    "regex": "^(\\d{3})\\s+(\\w{3}\\s+\\d{1,2})\\s+(\\w{3}\\s+\\d{1,2})\\s+(.+?)\\s+([\\d,]+\\.\\d{2})(\\s*-)?\\s*$",
    "fields": {
      "ref":         { "group": 1 },
      "trans_date":  { "group": 2, "kind": "date_md" },
      "post_date":   { "group": 3, "kind": "date_md" },
      "merchant":    { "group": 4, "kind": "string" },
      "amount":      { "group": 5, "kind": "amount" },
      "credit_flag": { "group": 6, "kind": "flag_present" }
    },
    "rules": [
      { "if": "credit_flag", "then_set": { "type": "income" } },
      { "else_set": { "type": "debit" } }
    ]
  },
  "skip_when": {
    "any_substring": ["Interest charges", "ANNUAL FEE", "INTEREST CHARGED", "Previous Balance", "Payments/Credits", "Purchases/charges", "NEW BALANCE", "MINIMUM PAYMENT"]
  },
  "validation": {
    "totals": {
      "purchases_field_regex": "Purchases/charges\\s+\\+\\s+\\$?([\\d,]+\\.\\d{2})",
      "credits_field_regex":   "Payments/credits\\s+-\\s+\\$?([\\d,]+\\.\\d{2})"
    }
  }
}
